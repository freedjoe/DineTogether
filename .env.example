# DineTogether Environment Configuration
# Note: DineTogether is an entirely client-side Progressive Web Application (PWA)
# running sql.js (WebAssembly SQLite) in the browser with IndexedDB binary persistence.
# It requires NO backend server, external API keys, or database credentials.

# Optional Local Development Server Port
PORT=8080

# Optional Base Path (if deploying to a subdirectory, e.g., https://yourdomain.com/dinetogether/)
# DineTogether uses relative paths for all assets and hash routing (#/_/admin), so it functions
# automatically in both root and subdirectory deployments.
PUBLIC_URL=/

